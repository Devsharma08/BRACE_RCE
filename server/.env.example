# Backend Environment Variables Example
PORT=5000
NODE_ENV="development"
NODE_MODE="development"

ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Neon Serverless PostgreSQL Database Connection
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# Upstash Serverless Redis Cache Endpoint
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Personal Github Access Token
GITHUB_KEY="your_github_token_here"

# JWT Secret
JWT_SECRET="very-strong-secret-key"

# Google OAuth — the ID-token flow (/auth/google) needs only the client id.
# The PKCE redirect flow (/auth/google/callback) needs the secret as well for
# confidential "Web application" OAuth clients.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Firebase Authentication ─────────────────────────────────────────
# Web app config from Firebase Console → Project settings → Your apps.
# Required for the Firebase-backed signup/signin, OTP login and password-reset
# routes (POST /auth/firebase/*, /auth/otp/*, /auth/password-reset/*). When these
# are unset the server falls back to the legacy bcrypt signup/signin path and the
# Firebase-only routes respond with 503.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
# Optional (Realtime Database / Analytics)
FIREBASE_DATABASE_URL=""
FIREBASE_MEASUREMENT_ID=""

# ── Gmail SMTP (OTP delivery) ───────────────────────────────────────
# Used by POST /auth/otp/send to email the 6-digit login code.
# Create a Gmail App Password (Google Account → Security → 2-Step Verification →
# App passwords) — do NOT use your regular Gmail password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── POST /execute abuse controls ───────────────────────────────────
# EXEC_DAILY_QUOTA: executions per requester (auth user, else IP) per UTC day.
# Fail-open: if the quota table is unreachable the request is allowed.
EXEC_DAILY_QUOTA=600
# EXECUTE_RATE_MAX: in-memory burst ceiling per IP per minute (default 15).
# Test suites raise this in jest.setup.js.
EXECUTE_RATE_MAX=15
# AUTH_RATE_MAX: auth endpoint burst ceiling per IP per 15 minutes (default 25).
# Test suites raise this in jest.setup.js.
AUTH_RATE_MAX=25

# ── Observability / execution infra ────────────────────────────────
# Sentry DSN for server-side error reporting (no-op when empty)
SENTRY_DSN=""
# Piston code-execution API used by services/codeExecution.ts
PISTON_URL="http://127.0.0.1:2000"
