# Backend Environment Variables
# Copy to server/.env or server/.env.development / server/.env.production

# PostgreSQL / Prisma Database URLs (Required)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?pgbouncer=true"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?pgbouncer=true"

# GitHub Personal Access Token (Required for runtime GitHub client calls)
GITHUB_KEY="your_github_token_here"

# Server Port (Optional, defaults to 5000)
PORT=5000

# Node Mode / Environment (Optional)
NODE_MODE=development
NODE_ENV=development

# JWT Secret key for authentication (Optional, defaults to "very-strong-secret-key")
JWT_SECRET="very-strong-secret-key"
