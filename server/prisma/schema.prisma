generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                    @id @default(uuid())
  username             String                    @unique
  email                String?                   @unique
  emailVerified        Boolean                   @default(true)
  password             String?
  role                 String                    @default("USER")
  avatarUrl            String?
  bio                  String?                   @default("try beat me")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  hostedEvents         Event[]                   @relation("HostedEvents")
  blockedUsers         EventBlock[]              @relation("BlockedBy")
  blockedInEvents      EventBlock[]              @relation("BlockedUsers")
  feedback             Feedback[]
  receivedRequest      FriendRequest[]           @relation("ReceivedRequest")
  sendRequest          FriendRequest[]           @relation("SentRequest")
  matchmakingQueue     MatchmakingQueue[]
  receivedMessages     Message[]                 @relation("ReceivedMessages")
  SentMessage          Message[]                 @relation("SentMessage")
  notifications        Notification[]            @relation("UserNotifications")
  createdProblems      Problem[]                 @relation("UserProblems")
  reportsFiled         QuestionReport[]          @relation("ReportsFiled")
  ReceivedReports      ReportMessage[]           @relation("ReportRecipient")
  SentReports          ReportMessage[]           @relation("ReportSender")
  TemplateSubscription TemplateSubscription[]
  learningProgress     UserLearningProgress[]
  learningSummary      UserLearningSummary?
  performances         UserPersonalPerformance[]
  problemProgress      UserProblemProgress[]
  User_A               User[]                    @relation("UserFriends")
  User_B               User[]                    @relation("UserFriends")
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedRequest", fields: [receiverId], references: [id])
  sender     User     @relation("SentRequest", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model Problem {
  id                 String                @id @default(uuid())
  name               String
  problem_number     Int?                  @unique
  github_oid         String?               @unique
  problem_definition String
  problem_hints      String[]
  difficulty_level   Level
  creatorId          String?
  isCustom           Boolean               @default(false)
  timeLimitMs        Int?                  @default(600000)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  data_structure     String?
  code_snippets      CodeSnippet[]
  codeSubmissions    CodeSubmission[]
  commonEvents       Event[]
  creator            User?                 @relation("UserProblems", fields: [creatorId], references: [id])
  test_cases         TestCase[]
  userProgress       UserProblemProgress[]
  events             Event[]               @relation("EventProblems")
}

model TestCase {
  id             String  @id @default(uuid())
  input          String
  expectedOutput String
  is_public      Boolean @default(true)
  problemId      String
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model CodeSnippet {
  id          String  @id @default(uuid())
  language    String
  code        String
  wrapperCode String?
  problemId   String
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Event {
  id               String                    @id @default(uuid())
  name             String?
  type             EventType                 @default(PUBLIC)
  status           String                    @default("WAITING")
  version          Int?                      @default(1)
  isPublic         Boolean?                  @default(true)
  description      String?
  hostId           String?
  isTemplate       Boolean?                  @default(false)
  commonProblemId  String?
  roomCode         String?                   @unique
  password         String?
  maxUsers         Int                       @default(2)
  totalTimeLimitMs Int?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  closesAt         DateTime?
  opensAt          DateTime?
  openedNotified   Boolean                   @default(false)
  commonProblem    Problem?                  @relation(fields: [commonProblemId], references: [id])
  host             User?                     @relation("HostedEvents", fields: [hostId], references: [id])
  blockedUsers     EventBlock[]
  subscribers      TemplateSubscription[]
  performances     UserPersonalPerformance[]
  problems         Problem[]                 @relation("EventProblems")
}

model UserPersonalPerformance {
  id                    String           @id @default(uuid())
  userId                String
  eventId               String
  questionsSolved       Int              @default(0)
  timeTakenMs           Int?
  status                String           @default("PENDING")
  score                 Int              @default(0)
  outcome               String?          /// WIN | DRAW | LOSS — resolved from pass flags
  battlePoints          Int?             /// +max / 0 / -max scaled by difficulty
  finalPoints           Int?             /// score after focus-penalty deduction (floored at 0)
  focusPenaltyPercent   Int?             @default(0)  /// exponential focus-loss penalty
  finishedAt            DateTime?        /// when the participant's verdict was recorded
  createdAt             DateTime         @default(now())
  submissions           CodeSubmission[]
  event                 Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

model EventBlock {
  id            String   @id @default(uuid())
  eventId       String
  blockedUserId String
  blockedById   String
  reason        String?
  createdAt     DateTime @default(now())
  blockedBy     User     @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedUser   User     @relation("BlockedUsers", fields: [blockedUserId], references: [id])
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, blockedUserId])
}

model CodeSubmission {
  id                        String                  @id @default(uuid())
  UserPersonalPerformanceId String
  problemId                 String
  submittedCode             String
  language                  String                  @default("javascript")
  status                    String                  @default("PENDING")
  runtimeMs                 Int?
  memoryKb                  Int?
  passedCase                Int
  totalCases                Int
  isBestSubmission          Boolean                 @default(false)
  attemptNumber             Int                     @default(1)
  createdAt                 DateTime                @default(now())
  userPersonalPerformance   UserPersonalPerformance @relation(fields: [UserPersonalPerformanceId], references: [id], onDelete: Cascade)
  problem                   Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([UserPersonalPerformanceId])
  @@index([problemId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  data       Json?
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessage", fields: [senderId], references: [id])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType   @default(SYSTEM)
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?
  user      User               @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([createdAt])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  content   String
  status    FeedbackStatus @default(PENDING)
  adminNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model QuestionReport {
  id         String         @id @default(uuid())
  questionId String
  reportedBy String
  reason     String
  status     ReportStatus   @default(FLAGGED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   ReportCategory @default(OTHER)
  detail     String?
  resolvedAt DateTime?
  reporter   User           @relation("ReportsFiled", fields: [reportedBy], references: [id])

  @@index([questionId, status])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model MatchmakingQueue {
  id                  String            @id @default(uuid())
  userId              String
  preferredDifficulty Level
  status              MatchmakingStatus @default(WAITING)
  joinedAt            DateTime          @default(now())
  matchedAt           DateTime?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, preferredDifficulty])
}

model TemplateSubscription {
  id                String   @id @default(uuid())
  userId            String
  templateEventId   String
  subscribedVersion Int
  createdAt         DateTime @default(now())
  templateEvent     Event    @relation(fields: [templateEventId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateEventId])
}

model UserProblemProgress {
  id              String    @id @default(uuid())
  userId          String
  problemId       String
  isSolved        Boolean   @default(false)
  solvedAt        DateTime?
  attempts        Int       @default(0)
  lastCode        String?
  lastLanguage    String?   @default("javascript")
  submissionTimes String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  problem         Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
}

model LearningItem {
  id             String                 @id @default(uuid())
  name           String
  order          Int
  category       String                 @default("")
  description    String?
  problemIds     String[]               @default([])
  prerequisites  String[]               @default([])
  nextStructures String[]               @default([])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  progress       UserLearningProgress[]

  @@index([order])
  @@index([category])
}

model UserLearningProgress {
  id             String       @id @default(uuid())
  userId         String
  learningItemId String
  progressStatus String       @default("NOT_STARTED")
  lastVisited    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, learningItemId])
  @@index([userId])
  @@index([learningItemId])
}

model UserLearningSummary {
  id             String   @id @default(uuid())
  userId         String   @unique
  completedCount Int      @default(0)
  lastUpdated    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExecutionQuota {
  keyHash   String
  date      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([keyHash, date])
}

model ExecutionLog {
  id         String   @id @default(uuid())
  keyHash    String
  userId     String?
  mode       String   @default("RUN")
  origin     String?
  status     Int      @default(200)
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([keyHash, createdAt])
}

model ReportMessage {
  id          String   @id @default(uuid())
  eventId     String
  category    String
  content     String
  status      String   @default("OPEN")
  senderId    String
  recipientId String
  createdAt   DateTime @default(now())
  recipient   User     @relation("ReportRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("ReportSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([eventId, senderId])
  @@index([eventId, recipientId])
}

enum Level {
  EASY
  MEDIUM
  HARD
}

enum EventType {
  FRIENDS
  BOT
  PUBLIC
  ONE_VS_ONE
  CUSTOM
  TOURNAMENT
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPT
  DIRECT_MESSAGE
  CHALLENGE_RECEIVED
  CHALLENGE_RESULT
  MATCH_RESULT
  SYSTEM
  WEEKLY_ANALYSIS
  EVENT_REPORT
  EVENT_RESULT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum ReportCategory {
  QUESTION
  DOUBT
  TESTCASE
  OTHER
}

enum ReportStatus {
  FLAGGED
  REVIEWED
  DISMISSED
  APPROVED
}

enum MatchmakingStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}
