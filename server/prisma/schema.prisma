generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  role      String   @default("USER")
  avatarUrl String?
  
  performances UserPersonalPerformance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// PROBLEMS & EXECUTION
// ------------------------------------------------------

enum Level {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id                 String     @id @default(uuid())
  name               String
  problem_number     Int        @unique
  github_oid         String     @unique // Link to your GitHub file structure
  problem_definition String     @db.Text
  problem_hints      String[]
  difficulty_level   Level
  
  test_cases         TestCase[]
  code_snippets      CodeSnippet[]
  
  commonEvents       Event[]
  performances       UserPersonalPerformance[]
  
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model TestCase {
  id             String   @id @default(uuid())
  input          String   @db.Text // Input to be piped into Docker/Piston
  expectedOutput String   @db.Text // Output to compare against
  is_public      Boolean  @default(true) // Public cases show in the UI
  
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model CodeSnippet {
  id          String  @id @default(uuid())
  language    String  // "java", "javascript", "python", "c", "cpp"
  code        String  @db.Text // The boilerplate/starter code
  wrapperCode String? @db.Text // Hidden wrapper code
  
  problemId   String
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// PVP CODING BATTLES
// ------------------------------------------------------

enum EventType {
  FRIENDS
  BOT
  PUBLIC
}

model Event {
  id          String    @id @default(uuid())
  name        String?   // Optional event name
  type        EventType @default(PUBLIC)
  status      String    @default("WAITING") // WAITING, IN_PROGRESS, FINISHED
  
  // If all users in the event solve the same question
  commonProblemId String?
  commonProblem   Problem? @relation(fields: [commonProblemId], references: [id])
  
  // Participants and their performances
  performances UserPersonalPerformance[]
  
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserPersonalPerformance {
  id           String   @id @default(uuid())
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  problemId    String?
  problem      Problem? @relation(fields: [problemId], references: [id])
  
  // Metrics
  questionsSolved Int     @default(0)
  timeTakenMs     Int?    // Time taken to solve
  status          String  @default("PENDING") // PENDING, PASSED, FAILED, TIMEOUT , SURRENDER
  score           Int     @default(0)
  
  createdAt       DateTime @default(now())
}
