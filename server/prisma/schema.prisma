generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String?
  role      String   @default("USER")
  avatarUrl String?
  bio String? @default("try beat me")
  
  performances UserPersonalPerformance[]

  SentMessage Message[] @relation("SentMessage")
  receivedMessages Message[] @relation("ReceivedMessages")

  hostedEvents Event[] @relation("HostedEvents")
  createdProblems Problem[] @relation("UserProblems")

  sendRequest FriendRequest[] @relation("SentRequest")
  receivedRequest FriendRequest[] @relation("ReceivedRequest")

  TemplateSubscription TemplateSubscription[]
  
  // friends system (self-relation)
  friends User[] @relation("UserFriends")
  friendOf User[] @relation("UserFriends")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FriendRequest {
  id String @id @default(uuid())
  senderId String
  sender User @relation("SentRequest",fields:[senderId],references:[id])
  receiverId String  
  receiver User @relation("ReceivedRequest",fields:[receiverId],references:[id])

  status String @default("PENDING") // PENDING,ACCEPTED,DECLINED,BLOCK

  createdAt DateTime @default(now())
  @@unique([senderId,receiverId]) // prevent duplicate requests
}

// ------------------------------------------------------
// PROBLEMS & EXECUTION
// ------------------------------------------------------

enum Level {
  EASY
  MEDIUM
  HARD
}

model Problem {
  id                 String     @id @default(uuid())
  name               String
  problem_number     Int?        @unique
  github_oid         String?     @unique // Link to your GitHub file structure
  problem_definition String     @db.Text
  problem_hints      String[]
  difficulty_level   Level

  //custom problem fields
  creatorId String?
  creator User? @relation("UserProblems",fields:[creatorId],references:[id])
  isCustom Boolean @default(false)
  
  test_cases         TestCase[]
  code_snippets      CodeSnippet[]
  
  commonEvents       Event[]
  performances       UserPersonalPerformance[]

  timeLimitMs Int? @default(600000)

  // playlist relation (connects to event)
  events Event[] @relation("EventProblems")
  
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model TestCase {
  id             String   @id @default(uuid())
  input          String   @db.Text // Input to be piped into Docker/Piston
  expectedOutput String   @db.Text // Output to compare against
  is_public      Boolean  @default(true) // Public cases show in the UI
  
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model CodeSnippet {
  id          String  @id @default(uuid())
  language    String  // "java", "javascript", "python", "c", "cpp"
  code        String  @db.Text // The boilerplate/starter code
  wrapperCode String? @db.Text // Hidden wrapper code
  
  problemId   String
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// PVP CODING BATTLES
// ------------------------------------------------------

enum EventType {
  FRIENDS
  BOT
  PUBLIC
}

model Event {
  id          String    @id @default(uuid())
  name        String?   // Optional event name
  type        EventType @default(PUBLIC)
  status      String    @default("WAITING") // WAITING, IN_PROGRESS, FINISHED
  version Int @default(1)

  // Advance rooom fields
  isPublic Boolean @default(true) // visible in lobby
  description String? @db.Text
  hostId String?
  host User? @relation("HostedEvents",fields:[hostId],references:[id])
  isTemplate Boolean @default(false)
  
  // If all users in the event solve the same question
  commonProblemId String?
  commonProblem   Problem? @relation(fields: [commonProblemId], references: [id])
  
  // Participants and their performances
  performances UserPersonalPerformance[]

  subscribers TemplateSubscription[]

  // create room support
  roomCode String? @unique 
  password String?
  maxUsers Int @default(2)

  // playlist relation (connects to problem)
  problems Problem[] @relation("EventProblems")
  
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserPersonalPerformance {
  id           String   @id @default(uuid())
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  problemId    String?
  problem      Problem? @relation(fields: [problemId], references: [id])
  
  // Metrics
  questionsSolved Int     @default(0)
  timeTakenMs     Int?    // Time taken to solve
  status          String  @default("PENDING") // PENDING, PASSED, FAILED, TIMEOUT , SURRENDER
  score           Int     @default(0)
  
  createdAt       DateTime @default(now())
}

model Message {
  id String @id @default(uuid())
  content String @db.Text

  senderId String
  sender User @relation("SentMessage",fields:[senderId],references:[id])

  receiverId String
  receiver User @relation("ReceivedMessages", fields:[receiverId],references:[id])

  createdAt DateTime @default(now())
  
}

model TemplateSubscription {
  id                String   @id @default(uuid())
  
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  templateEventId   String
  templateEvent     Event    @relation(fields: [templateEventId], references: [id], onDelete: Cascade)
  
  subscribedVersion Int      // Locks in the version of the template they subscribed to

  createdAt         DateTime @default(now())

  @@unique([userId, templateEventId]) // A user can only subscribe to a template once
}
