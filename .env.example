# Frontend Environment Variables (Vite)
# Copy to .env or .env.local in the root directory

# Backend API base URL for Axios API client
VITE_BACKEND_URL="http://localhost:5000"

# Base URL for auth endpoints (e.g. Google OAuth login)
VITE_BASE_URL="http://localhost:5000"

# Base API URL used in terminal feature (defaults to http://localhost:5000)
VITE_API_URL="http://localhost:5000"

# Cloudflare Turnstile Site Key for captcha verification (defaults to test key '1x00000000000000000000AA')
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"
