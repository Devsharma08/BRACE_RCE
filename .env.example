# Frontend Environment Variables (Vite)
# Copy to .env or .env.local in the project root (Vite picks up .env.[mode] too)

# Backend API base URL for the Axios client (trailing slashes are stripped)
VITE_BACKEND_URL="http://localhost:3000/api"

# Base API URL used in the terminal feature
# (falls back to VITE_BACKEND_URL when unset)
VITE_API_URL="http://localhost:3000/api"

# Socket.io server URL (optional)
# Falls back to VITE_API_URL → VITE_BACKEND_URL → http://localhost:3000;
# a trailing /api suffix is stripped automatically.
VITE_SOCKET_URL=""

# Cloudflare Turnstile Site Key — the captcha only renders when the 'turnstile'
# feature flag is enabled AND a key is set. The value below is Cloudflare's
# public always-pass TEST key for local development.
#
# NOTE: VITE_* variables are inlined into the JS bundle at BUILD time (not read
# at runtime). In Docker, `.env` is dockerignored — docker-compose passes these
# to the image via `build.args`, so they must be present in .env on the build
# host or the UI will show "not configured" banners in production.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Google OAuth Client ID (Web application client from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"
