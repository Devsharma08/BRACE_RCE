# Frontend Environment Variables (Vite)
# Copy to .env or .env.local in the project root (Vite picks up .env.[mode] too)

# Backend API base URL for the Axios client (trailing slashes are stripped)
VITE_BACKEND_URL="http://localhost:3000/api"

# Base API URL used in the terminal feature
# (falls back to VITE_BACKEND_URL when unset)
VITE_API_URL="http://localhost:3000/api"

# Socket.io server URL (optional)
# Falls back to VITE_API_URL → VITE_BACKEND_URL → http://localhost:3000;
# a trailing /api suffix is stripped automatically.
VITE_SOCKET_URL=""

# Google OAuth Client ID (Web application client from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"
