{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/api/(.*)", "destination": "https://bracerce.server.devsharma.dev/api/$1" },
    { "source": "/health", "destination": "https://bracerce.server.devsharma.dev/health" },
    { "source": "/live", "destination": "https://bracerce.server.devsharma.dev/live" },
    { "source": "/ready", "destination": "https://bracerce.server.devsharma.dev/ready" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
